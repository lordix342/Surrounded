local game_state = require("main.modules.game_state")
local pathfinding = require("main.modules.pathfinding")
local sound_manager = require("main.modules.sound_manager")

local HIT_COOLDOWN = 0.5
local WAYPOINT_REACH_RADIUS = 10

go.property("enemy_level", 1)
go.property("enemy_type", hash("normal"))
go.property("max_hp", 10)
go.property("move_speed", 45)
go.property("contact_damage", 5)

local function is_finite_number(value)
	return value == value and value > -10000 and value < 10000
end

local function is_finite_vector3(v)
	return is_finite_number(v.x) and is_finite_number(v.y) and is_finite_number(v.z)
end

local function clamp_enemy_level(level)
	local value = math.floor(level or 1)
	if value < 1 then
		return 1
	end
	if value > 9 then
		return 9
	end
	return value
end

local function apply_enemy_visual(self)
	if self.enemy_type == hash("boss_death_knight") then
		sprite.play_flipbook("#sprite", hash("boss_death_knight"))
		go.set_scale(vmath.vector3(1.4, 1.4, 1.0))
		self.is_boss = true
		print("VISUAL APPLIED: boss_death_knight")
	elseif self.enemy_type == hash("boss_necromancer") then
		sprite.play_flipbook("#sprite", hash("boss_necromancer"))
		go.set_scale(vmath.vector3(1.35, 1.35, 1.0))
		self.is_boss = true
		print("VISUAL APPLIED: boss_necromancer")
	elseif self.enemy_type == hash("boss_hound") then
		sprite.play_flipbook("#sprite", hash("boss_hound"))
		go.set_scale(vmath.vector3(1.35, 1.35, 1.0))
		self.is_boss = true
		print("VISUAL APPLIED: boss_hound")
	elseif self.enemy_type == hash("slime") then
		sprite.play_flipbook("#sprite", hash("enemy_slime"))
		go.set_scale(vmath.vector3(1.0, 1.0, 1.0))
		print("VISUAL APPLIED: enemy_slime")
	elseif self.enemy_type == hash("skeleton") then
		sprite.play_flipbook("#sprite", hash("enemy_skeleton"))
		go.set_scale(vmath.vector3(1.0, 1.0, 1.0))
		print("VISUAL APPLIED: enemy_skeleton")
	elseif self.enemy_type == hash("eye") then
		sprite.play_flipbook("#sprite", hash("enemy_eye"))
		go.set_scale(vmath.vector3(1.0, 1.0, 1.0))
		print("VISUAL APPLIED: enemy_eye")
	elseif self.enemy_type == hash("zombie") then
		sprite.play_flipbook("#sprite", hash("enemy_zombie"))
		go.set_scale(vmath.vector3(1.0, 1.0, 1.0))
		print("VISUAL APPLIED: enemy_zombie")
	else
		local level = clamp_enemy_level(self.enemy_level)
		sprite.play_flipbook("#sprite", hash("enemy_" .. tostring(level)))
		go.set_scale(vmath.vector3(1.0, 1.0, 1.0))
	end
end

function init(self)
	self.enemy_level = clamp_enemy_level(self.enemy_level)
	self.hp = self.max_hp
	self.contact_cooldown = 0
	self.hero_url = msg.url("/hero_ob")
	self.id = go.get_id()
	self.correction = vmath.vector3()

	self.path = {}
	self.path_index = 1
	self.path_timer = math.random() * 0.2
	self.is_dying = false

	game_state.register_enemy(self.id)

	local pos = go.get_position()
	pos.z = 0.05
	go.set_position(pos)

	apply_enemy_visual(self)
end

function final(self)
	game_state.unregister_enemy(self.id or go.get_id())
end

function update(self, dt)
	self.correction = vmath.vector3()

	if self.is_dying or not game_state.is_running() then
		return
	end

	self.contact_cooldown = math.max(0, self.contact_cooldown - dt)

	local hero_pos = go.get_position(self.hero_url)
	local my_pos = go.get_position()
	if not is_finite_vector3(hero_pos) or not is_finite_vector3(my_pos) then
		return
	end

	-- Periodic path recalculation
	self.path_timer = self.path_timer - dt
	if self.path_timer <= 0 or not self.path or #self.path == 0 or self.path_index > #self.path then
		self.path_timer = 0.35 + math.random() * 0.1
		local new_path = pathfinding.get_path(my_pos, hero_pos)
		if new_path and #new_path > 0 then
			self.path = new_path
			self.path_index = 1
		elseif not self.path or #self.path == 0 or self.path_index > #self.path then
			self.path = { hero_pos }
			self.path_index = 1
		end
	end

	-- Current waypoint
	local target = (self.path and self.path[self.path_index]) or hero_pos
	local to_target = target - my_pos
	to_target.z = 0
	local dist = vmath.length(to_target)

	-- Advance to next waypoint if reached current one
	if dist <= WAYPOINT_REACH_RADIUS and self.path and self.path_index < #self.path then
		self.path_index = self.path_index + 1
		target = self.path[self.path_index] or hero_pos
		to_target = target - my_pos
		to_target.z = 0
		dist = vmath.length(to_target)
	end

	if dist > 1 then
		local dir = to_target / dist
		local current_speed = self.move_speed
		if self.slow_timer and self.slow_timer > 0 then
			self.slow_timer = self.slow_timer - dt
			current_speed = current_speed * (self.slow_factor or 0.6)
		end
		local step = current_speed * dt
		if step > dist then
			step = dist
		end
		local next_pos = my_pos + dir * step
		next_pos.z = 0.05
		if is_finite_vector3(next_pos) then
			go.set_position(next_pos)
		end
	end
end

function on_message(self, message_id, message, sender)
	-- Physics collision with walls (kinematic sliding / blocking)
	if message_id == hash("contact_point_response") then
		if not game_state.is_running() then
			return
		end
		if message.other_group ~= hash("walls") then
			return
		end
		if message.distance <= 0 then
			return
		end

		local projection = vmath.dot(self.correction, message.normal)
		local compensation = (message.distance - projection) * message.normal
		if (compensation.x ~= 0 or compensation.y ~= 0) and is_finite_vector3(compensation) then
			local pos = go.get_position() + compensation
			if is_finite_vector3(pos) then
				go.set_position(pos)
				self.correction = self.correction + compensation
			end
		end

		-- If touching a wall, advance waypoint if it lies into the wall, and softly schedule recalculation
		if self.path and self.path_index < #self.path then
			local wp = self.path[self.path_index]
			if wp then
				local to_wp = wp - go.get_position()
				to_wp.z = 0
				if vmath.dot(to_wp, message.normal) < -0.1 then
					self.path_index = self.path_index + 1
				end
			end
		end
		self.path_timer = math.min(self.path_timer, 0.15)
		return
	end

	-- Physics collision with hero (deal contact damage)
	if message_id == hash("collision_response") then
		if not game_state.is_running() then
			return
		end
		if message.other_group == hash("default") and self.contact_cooldown <= 0 then
			msg.post(self.hero_url, "enemy_hit", { damage = self.contact_damage })
			self.contact_cooldown = HIT_COOLDOWN
		end
		return
	end

	if message_id == hash("apply_slow") then
		self.slow_timer = message.duration or 1.0
		self.slow_factor = message.factor or 0.6
		go.cancel_animations("#sprite", "tint")
		go.set("#sprite", "tint", vmath.vector4(0.4, 0.8, 2.5, 1.0))
		go.animate("#sprite", "tint", go.PLAYBACK_ONCE_FORWARD, vmath.vector4(1, 1, 1, 1), go.EASING_OUTQUAD, message.duration or 1.0)
		return
	end

	-- Damage taken from weapon
	if message_id == hash("weapon_hit") then
		if self.is_dying then
			return
		end

		local dmg = message.damage or 1
		self.hp = self.hp - dmg

		local my_pos = go.get_position()

		-- 1. Spawn floating damage number
		local txt_pos = vmath.vector3(my_pos.x, my_pos.y + 10, 0.5)
		msg.post("/controller", "spawn_damage_text", {
			position = txt_pos,
			damage = dmg,
		})

		-- 2. Visual hit flash & squash punch
		go.cancel_animations("#sprite", "tint")
		go.set("#sprite", "tint", vmath.vector4(2.2, 0.35, 0.35, 1.0))
		go.animate("#sprite", "tint", go.PLAYBACK_ONCE_FORWARD, vmath.vector4(1, 1, 1, 1), go.EASING_OUTQUAD, 0.12)

		go.cancel_animations(".", "scale")
		local base_scale = self.is_boss and 1.4 or 1.0
		go.set_scale(vmath.vector3(base_scale * 1.2, base_scale * 0.85, 1))
		go.animate(".", "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(base_scale, base_scale, 1), go.EASING_OUTBACK, 0.15)

		-- 3. Knockback impulse (bosses have heavy resistance)
		local source_pos = message.source_pos or go.get_position(self.hero_url)
		local kb_dir = my_pos - source_pos
		kb_dir.z = 0
		local kb_len = vmath.length(kb_dir)
		if kb_len > 0.001 then
			kb_dir = kb_dir / kb_len
			local force = self.is_boss and 3.0 or 10.0
			local kb_pos = my_pos + kb_dir * force
			kb_pos.z = my_pos.z
			if is_finite_vector3(kb_pos) then
				go.set_position(kb_pos)
			end
		end

		-- 4. Death handling with shrink animation
		if self.hp <= 0 then
			self.is_dying = true
			sound_manager.play_enemy_death()
			msg.post("#collisionobject", "disable")
			game_state.unregister_enemy(self.id)
			msg.post("/controller", "enemy_killed", {
				position = go.get_position(),
				level = self.enemy_level,
				enemy_id = self.id,
				is_boss = self.is_boss or false,
			})
			go.animate(".", "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(0, 0, 1), go.EASING_INBACK, 0.14, 0, function()
				go.delete()
			end)
		end
	end
end
