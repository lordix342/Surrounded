local function refresh_hp(self)
	local health = game_state.health
	local max_health = math.max(1, game_state.max_health)
	local ratio = health / max_health
	if ratio < 0 then
		ratio = 0
	end
	if ratio > 1 then
		ratio = 1
	end

	local full_width = 220
	gui.set_size(self.hp_fill, vmath.vector3(full_width * ratio, 22, 0))
	gui.set_text(self.hp_label, string.format("HP %d/%d", health, max_health))
end

local function refresh_xp(self)
	local xp = game_state.xp or 0
	local xp_next = math.max(1, game_state.xp_next or 65)
	local is_maxed = game_state.is_skill_tree_maxed()

	local ratio
	if is_maxed then
		ratio = 1.0
		gui.set_text(self.xp_label, string.format("LVL %d [MAX] - MASTERED", game_state.level))
	else
		ratio = math.min(1.0, math.max(0.0, xp / xp_next))
		gui.set_text(self.xp_label, string.format("LVL %d - %d/%d XP", game_state.level, xp, xp_next))
	end

	local full_width = 220
	gui.set_size(self.xp_fill, vmath.vector3(full_width * ratio, 16, 0))
	gui.set_text(self.skills_hud_label, string.format("SKILLS [%d]", game_state.skill_points))

	if game_state.skill_points > 0 and not is_maxed then
		local pulse = 0.5 + 0.5 * math.sin((os.clock() or 0) * 6.0)
		gui.set_color(self.skills_hud_btn, vmath.vector3(0.85 + 0.25 * pulse, 0.8 + 0.2 * pulse, 0.65 + 0.35 * pulse))
	else
		gui.set_color(self.skills_hud_btn, vmath.vector3(0.82, 0.82, 0.82))
	end
end

local function refresh_timer(self)
	local mins = math.floor(self.elapsed_time / 60)
	local secs = math.floor(self.elapsed_time % 60)
	gui.set_text(self.timer_label, string.format("%02d:%02d", mins, secs))
end

local function refresh_kills(self)
	gui.set_text(self.kills_label, string.format("KILLS: %d", self.kills))
end

local function show_pause(self, visible)
	gui.set_enabled(self.pause_root, visible)
	gui.set_enabled(self.pause_btn, not visible and not game_state.dead and not self.upgrade_showing and not self.skill_tree_showing)
end

local function show_death(self, visible)
	gui.set_enabled(self.death_root, visible)
	gui.set_enabled(self.pause_btn, not visible)
	if visible then
		gui.set_enabled(self.pause_root, false)
		gui.set_enabled(self.upgrade_root, false)
		gui.set_enabled(self.skill_tree_root, false)
		self.upgrade_showing = false
		self.skill_tree_showing = false
	end
end

local function set_paused(self, paused)
	if game_state.dead or self.upgrade_showing or self.skill_tree_showing then
		return
	end
	game_state.set_paused(paused)
	show_pause(self, paused)
end

-- ====================================================================
-- SKILL TREE SCREEN CONTROLLER
-- ====================================================================

local function update_tree_node_visuals(self)
	gui.set_text(self.tree_sp_label, string.format("SKILL POINTS: %d", game_state.skill_points))

	for skill_id, skill in pairs(SKILL_TREE_CATALOG) do
		local node = self.tree_nodes[skill_id]
		if node then
			local lvl = game_state.get_skill_level(skill_id)
			local can, reason = game_state.can_unlock_skill(skill_id)
			local is_selected = (skill_id == self.selected_skill_id)

			-- Display Level text directly on node name
			if lvl >= 5 then
				gui.set_text(node.name, string.format("%s [MAX]", skill.title))
			elseif lvl > 0 then
				gui.set_text(node.name, string.format("%s (Lv %d)", skill.title, lvl))
			else
				gui.set_text(node.name, skill.title)
			end

			-- Visual node box state
			if lvl >= 5 then
				gui.set_color(node.box, vmath.vector3(0.18, 0.62, 0.35)) -- Emerald green for maxed
				gui.set_color(node.icon, vmath.vector3(1.0, 1.0, 1.0))
			elseif lvl > 0 then
				gui.set_color(node.box, vmath.vector3(0.2, 0.45, 0.58)) -- Teal for active levels
				gui.set_color(node.icon, vmath.vector3(1.0, 1.0, 1.0))
			elseif can then
				gui.set_color(node.box, vmath.vector3(0.62, 0.50, 0.16)) -- Gold: ready to learn
				gui.set_color(node.icon, vmath.vector3(1.0, 0.95, 0.75))
			elseif reason == "NEED_SP" then
				gui.set_color(node.box, vmath.vector3(0.26, 0.32, 0.44)) -- Slate: prerequisite met but 0 SP
				gui.set_color(node.icon, vmath.vector3(0.85, 0.85, 0.9))
			else
				gui.set_color(node.box, vmath.vector3(0.11, 0.12, 0.16)) -- Dark: locked/exclusive
				gui.set_color(node.icon, vmath.vector3(0.35, 0.35, 0.4))
			end

			-- Selection scale highlight
			if is_selected then
				gui.set_scale(node.box, vmath.vector3(1.15, 1.15, 1.0))
			else
				gui.set_scale(node.box, vmath.vector3(1.0, 1.0, 1.0))
			end
		end
	end
end

local function select_tree_node(self, skill_id)
	local skill = SKILL_TREE_CATALOG[skill_id]
	if not skill then
		return
	end
	self.selected_skill_id = skill_id

	local lvl = game_state.get_skill_level(skill_id)
	local can, reason = game_state.can_unlock_skill(skill_id)

	gui.set_text(self.tree_selected_label, string.format("Selected: %s (Level %d/5)", skill.title, lvl))

	if lvl >= 5 then
		gui.set_text(self.tree_learn_label, "MAX LEVEL")
		gui.set_color(self.tree_learn_btn, vmath.vector3(0.5, 0.65, 0.5))
	elseif can then
		gui.set_text(self.tree_learn_label, string.format("UPGRADE -> LV %d (1 SP)", lvl + 1))
		gui.set_color(self.tree_learn_btn, vmath.vector3(1.0, 1.0, 1.0))
	elseif reason == "NEED_SP" then
		gui.set_text(self.tree_learn_label, "NEED 1 SP")
		gui.set_color(self.tree_learn_btn, vmath.vector3(0.65, 0.55, 0.4))
	elseif reason == "EXCLUSIVE_FROST" then
		gui.set_text(self.tree_learn_label, "LOCKED (FROST CHOSEN)")
		gui.set_color(self.tree_learn_btn, vmath.vector3(0.35, 0.35, 0.38))
	elseif reason == "EXCLUSIVE_FIRE" then
		gui.set_text(self.tree_learn_label, "LOCKED (FIRE CHOSEN)")
		gui.set_color(self.tree_learn_btn, vmath.vector3(0.35, 0.35, 0.38))
	else
		gui.set_text(self.tree_learn_label, "LOCKED")
		gui.set_color(self.tree_learn_btn, vmath.vector3(0.35, 0.35, 0.38))
	end

	update_tree_node_visuals(self)
end

local function show_skill_tree(self)
	if game_state.dead then
		return
	end

	self.skill_tree_showing = true
	self.input_cooldown = 0.3
	game_state.set_paused(true)
	sound_manager.play_chest_open()

	gui.set_enabled(self.pause_btn, false)
	gui.set_enabled(self.pause_root, false)
	gui.set_enabled(self.upgrade_root, false)
	self.upgrade_showing = false

	gui.set_enabled(self.skill_tree_root, true)
	gui.set_scale(self.skill_tree_root, vmath.vector4(1, 1, 1, 0))
	gui.set_enabled(self.tooltip_root, false)

	select_tree_node(self, self.selected_skill_id or "fire_aura")
	print("DEBUG: SKILL TREE OPENED")
end

local function close_skill_tree(self)
	self.skill_tree_showing = false
	gui.set_enabled(self.skill_tree_root, false)
	gui.set_enabled(self.tooltip_root, false)
	game_state.set_paused(false)
	gui.set_enabled(self.pause_btn, true)
	refresh_xp(self)
	print("DEBUG: SKILL TREE CLOSED")
end

local function learn_selected_skill(self)
	if not self.selected_skill_id then
		return
	end

	local ok, next_lvl = game_state.unlock_skill(self.selected_skill_id)
	if ok then
		sound_manager.play_slash()
		select_tree_node(self, self.selected_skill_id)
		refresh_xp(self)
		refresh_hp(self)
		print("SKILL UPGRADED: " .. tostring(self.selected_skill_id) .. " to Level " .. tostring(next_lvl))
	end
end

-- ====================================================================
-- RANDOM UPGRADE CARDS CONTROLLER (CHESTS)
-- ====================================================================

local function pick_random_upgrades()
	local available = {}
	for _, up in ipairs(UPGRADE_CATALOG) do
		if up.repeatable or not game_state.is_card_maxed(up.id) then
			table.insert(available, up)
		end
	end

	-- If available pool is small, ensure repeatable utility cards fill the choices
	if #available < 3 then
		for _, up in ipairs(UPGRADE_CATALOG) do
			if up.repeatable then
				table.insert(available, up)
			end
		end
	end

	local picked = {}
	for i = 1, 3 do
		if #available > 0 then
			local idx = math.random(1, #available)
			table.insert(picked, available[idx])
			table.remove(available, idx)
		end
	end
	return picked
end

local function show_upgrades(self)
	if game_state.dead or self.skill_tree_showing then
		return
	end

	self.upgrade_showing = true
	self.input_cooldown = 0.45
	game_state.set_paused(true)
	sound_manager.play_chest_open()

	gui.set_enabled(self.pause_btn, false)
	gui.set_enabled(self.pause_root, false)

	local picked = pick_random_upgrades()
	self.active_card_ids = {}

	for i = 1, 3 do
		local card = picked[i]
		if card then
			self.active_card_ids[i] = card.id
			local slot = self.card_slots[i]
			gui.set_text(slot.title, card.title)
			gui.set_text(slot.desc, card.desc)
			gui.play_flipbook(slot.icon, hash(card.icon))
		end
	end

	gui.set_enabled(self.upgrade_root, true)
	gui.set_scale(self.upgrade_root, vmath.vector4(1, 1, 1, 0))
	print("DEBUG: UPGRADE MODAL SHOWN - waiting for player selection")
end

local function select_upgrade(self, index)
	local upgrade_id = self.active_card_ids and self.active_card_ids[index]
	if not upgrade_id then
		return
	end

	game_state.record_card_upgrade(upgrade_id)
	sound_manager.play_slash()
	msg.post("/hero_ob#controller", "apply_upgrade", { upgrade_id = upgrade_id })

	self.upgrade_showing = false
	gui.set_enabled(self.upgrade_root, false)
	game_state.set_paused(false)
	gui.set_enabled(self.pause_btn, true)
	refresh_hp(self)
	refresh_xp(self)
	print("UPGRADE SELECTED: " .. tostring(upgrade_id))
end

-- ====================================================================
-- INITIALIZATION & LIFECYCLE
-- ====================================================================

local function resize_overlays(self)
	local win_w, win_h = window.get_size()
	if win_w ~= self.last_win_w or win_h ~= self.last_win_h then
		self.last_win_w = win_w
		self.last_win_h = win_h
		local max_dim = math.max(4000, math.max(win_w, win_h) * 4)
		local overlay_size = vmath.vector3(max_dim, max_dim, 0)
		local overlays = { self.pause_root, self.death_root, self.upgrade_root, self.skill_tree_root }
		for _, node in ipairs(overlays) do
			if node then
				gui.set_size(node, overlay_size)
			end
		end
	end
end

