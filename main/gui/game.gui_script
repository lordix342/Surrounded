		},
		thunderstorm = {
			box = gui.get_node("node_thunder"),
			icon = gui.get_node("node_thunder_icon"),
			name = gui.get_node("node_thunder_name"),
		},
		magnet = {
			box = gui.get_node("node_mag_1"),
			icon = gui.get_node("node_mag_1_icon"),
			name = gui.get_node("node_mag_1_name"),
		},
		vitality = {
			box = gui.get_node("node_vitality"),
			icon = gui.get_node("node_vitality_icon"),
			name = gui.get_node("node_vitality_name"),
		},
		haste = {
			box = gui.get_node("node_haste"),
			icon = gui.get_node("node_haste_icon"),
			name = gui.get_node("node_haste_name"),
		},
	}

	-- Chest Card Slots
	self.card_slots = {
		{
			bg = gui.get_node("card_1_bg"),
			btn = gui.get_node("card_1_btn"),
			icon = gui.get_node("card_1_icon"),
			title = gui.get_node("card_1_title"),
			desc = gui.get_node("card_1_desc"),
		},
		{
			bg = gui.get_node("card_2_bg"),
			btn = gui.get_node("card_2_btn"),
			icon = gui.get_node("card_2_icon"),
			title = gui.get_node("card_2_title"),
			desc = gui.get_node("card_2_desc"),
		},
		{
			bg = gui.get_node("card_3_bg"),
			btn = gui.get_node("card_3_btn"),
			icon = gui.get_node("card_3_icon"),
			title = gui.get_node("card_3_title"),
			desc = gui.get_node("card_3_desc"),
		},
	}

	gui.set_enabled(self.hp_bg, true)
	gui.set_enabled(self.xp_bg, true)
	gui.set_enabled(self.pause_btn, true)
	gui.set_enabled(self.skills_hud_btn, true)
	gui.set_enabled(self.upgrade_root, false)
	gui.set_enabled(self.skill_tree_root, false)
	gui.set_enabled(self.tooltip_root, false)
	show_pause(self, false)
	show_death(self, false)

	refresh_hp(self)
	refresh_xp(self)
	refresh_timer(self)
	refresh_kills(self)
	resize_overlays(self)
	print("GUI ready with Skill Tree, XP System, and Upgrades")
end

function update(self, dt)
	resize_overlays(self)
	refresh_hp(self)
	refresh_xp(self)

	if self.input_cooldown and self.input_cooldown > 0 then
		self.input_cooldown = self.input_cooldown - dt
	end

	if game_state.is_running() then
		self.elapsed_time = self.elapsed_time + dt
		refresh_timer(self)
	end
end

function on_message(self, message_id, message)
	if message_id == hash("update_health") then
		game_state.set_health(message.health or game_state.health, message.max_health or game_state.max_health)
		refresh_hp(self)
		return
	end

	if message_id == hash("update_xp") then
		refresh_xp(self)
		return
	end

	if message_id == hash("update_kills") then
		self.kills = message.kills or (self.kills + 1)
		refresh_kills(self)
		return
	end

	if message_id == hash("player_died") then
		game_state.set_dead(true)
		show_death(self, true)
		return
	end

	if message_id == hash("show_upgrade_cards") then
		show_upgrades(self)
		return
	end

	if message_id == hash("show_skill_tree") then
		show_skill_tree(self)
		return
	end

	if message_id == hash("set_pause") then
		set_paused(self, message.paused)
	end
end

function on_input(self, action_id, action)
	if action_id == hash("pause_toggle") and action.pressed then
		if not game_state.dead and not self.upgrade_showing and not self.skill_tree_showing then
			set_paused(self, not game_state.paused)
		end
		return true
	end

	-- Tooltip hover tracking when Skill Tree modal is open
	if self.skill_tree_showing and action.x and action.y then
		local hovered_id = nil
		for skill_id, node in pairs(self.tree_nodes) do
			if gui.pick_node(node.box, action.x, action.y)
				or gui.pick_node(node.icon, action.x, action.y)
				or gui.pick_node(node.name, action.x, action.y) then
				hovered_id = skill_id
				break
			end
		end

		if hovered_id then
			local skill = SKILL_TREE_CATALOG[hovered_id]
			local lvl = game_state.get_skill_level(hovered_id)
			local can, reason = game_state.can_unlock_skill(hovered_id)

			gui.set_enabled(self.tooltip_root, true)
			gui.set_text(self.tooltip_title, string.format("%s  [Level %d/5]", skill.title, lvl))
			gui.set_text(self.tooltip_tier, skill.tier)

			-- Build description with current and next level preview
			local desc_str = skill.desc .. "\n"
			if lvl > 0 and skill.levels and skill.levels[lvl] then
				desc_str = desc_str .. string.format("[Current Lv %d]: %s\n", lvl, skill.levels[lvl])
			end
			if lvl < 5 and skill.levels and skill.levels[lvl + 1] then
				desc_str = desc_str .. string.format("[Next Lv %d]: %s", lvl + 1, skill.levels[lvl + 1])
			elseif lvl >= 5 then
				desc_str = desc_str .. "[MAXIMUM LEVEL REACHED]"
			end
			gui.set_text(self.tooltip_desc, desc_str)

			if lvl >= 5 then
				gui.set_text(self.tooltip_status, "STATUS: MASTERED (MAX LEVEL 5/5)")
				gui.set_color(self.tooltip_status, vmath.vector3(0.3, 1.0, 0.5))
			elseif reason == "EXCLUSIVE_FROST" then
				gui.set_text(self.tooltip_status, "STATUS: LOCKED (Exclusive: Frost Aura Chosen)")
				gui.set_color(self.tooltip_status, vmath.vector3(0.95, 0.35, 0.35))
			elseif reason == "EXCLUSIVE_FIRE" then
				gui.set_text(self.tooltip_status, "STATUS: LOCKED (Exclusive: Fire Aura Chosen)")
				gui.set_color(self.tooltip_status, vmath.vector3(0.95, 0.35, 0.35))
			elseif reason == "REQUIRES_AURA" then
				gui.set_text(self.tooltip_status, "STATUS: LOCKED (Requires Fire Aura or Frost Aura)")
				gui.set_color(self.tooltip_status, vmath.vector3(0.95, 0.35, 0.35))
			elseif reason == "REQUIRES_LIGHTNING" then
				gui.set_text(self.tooltip_status, "STATUS: LOCKED (Requires Lightning Strike Lv 1)")
				gui.set_color(self.tooltip_status, vmath.vector3(0.95, 0.35, 0.35))
			elseif reason == "REQUIRES_CHAIN" then
				gui.set_text(self.tooltip_status, "STATUS: LOCKED (Requires Chain Bolt Lv 1)")
				gui.set_color(self.tooltip_status, vmath.vector3(0.95, 0.35, 0.35))
			elseif reason == "REQUIRES_MAGNET" then
				gui.set_text(self.tooltip_status, "STATUS: LOCKED (Requires Magnetism Lv 1)")
				gui.set_color(self.tooltip_status, vmath.vector3(0.95, 0.35, 0.35))
			elseif reason == "REQUIRES_VITALITY" then
				gui.set_text(self.tooltip_status, "STATUS: LOCKED (Requires Titan Blood Lv 1)")
				gui.set_color(self.tooltip_status, vmath.vector3(0.95, 0.35, 0.35))
			elseif reason == "NEED_SP" then
				gui.set_text(self.tooltip_status, string.format("STATUS: AVAILABLE (Need 1 SP for Lv %d)", lvl + 1))
				gui.set_color(self.tooltip_status, vmath.vector3(1.0, 0.85, 0.3))
			else
				gui.set_text(self.tooltip_status, string.format("STATUS: READY TO UPGRADE -> LEVEL %d!", lvl + 1))
				gui.set_color(self.tooltip_status, vmath.vector3(0.4, 1.0, 0.6))
			end

			-- Position tooltip cleanly clamped inside the panel
			local node_pos = gui.get_position(self.tree_nodes[hovered_id].box)
			local tip_x = math.max(-240, math.min(240, node_pos.x))
			local tip_y
			if node_pos.y < -50 then
				tip_y = node_pos.y + 125
			else
				tip_y = node_pos.y - 125
			end
			gui.set_position(self.tooltip_root, vmath.vector3(tip_x, tip_y, 0))
		else
			gui.set_enabled(self.tooltip_root, false)
		end
	end

	if action_id ~= hash("touch") then
		return false
	end

	if not action.pressed then
		return false
	end

	-- 1. Skill Tree modal click interaction
	if self.skill_tree_showing then
		if self.input_cooldown and self.input_cooldown > 0 then
			return true
		end

		if (self.tree_close_btn and gui.pick_node(self.tree_close_btn, action.x, action.y))
			or (self.tree_close_label and gui.pick_node(self.tree_close_label, action.x, action.y)) then
			close_skill_tree(self)
			return true
		end

		if (self.tree_learn_btn and gui.pick_node(self.tree_learn_btn, action.x, action.y))
			or (self.tree_learn_label and gui.pick_node(self.tree_learn_label, action.x, action.y)) then
			learn_selected_skill(self)
			return true
		end

		for skill_id, node in pairs(self.tree_nodes) do
			if gui.pick_node(node.box, action.x, action.y)
				or gui.pick_node(node.icon, action.x, action.y)
				or gui.pick_node(node.name, action.x, action.y) then
				select_tree_node(self, skill_id)
				sound_manager.play_slash()
				return true
			end
		end

		return true -- Consume click while modal is open
	end

	-- 2. Upgrade cards modal interaction
	if self.upgrade_showing then
		if self.input_cooldown and self.input_cooldown > 0 then
			return true
		end
		for i = 1, 3 do
			local slot = self.card_slots[i]
			if gui.pick_node(slot.btn, action.x, action.y)
				or gui.pick_node(slot.bg, action.x, action.y)
				or gui.pick_node(slot.icon, action.x, action.y)
				or gui.pick_node(slot.title, action.x, action.y)
				or gui.pick_node(slot.desc, action.x, action.y) then
				select_upgrade(self, i)
				return true
			end
		end
		return true
	end

	-- 3. Game over / retry interaction
	if game_state.dead then
		if gui.pick_node(self.retry_btn, action.x, action.y) then
			game_state.reset()
			sys.reboot()
			return true
		end
		return true
	end

	-- 4. Pause menu interaction
	if game_state.paused then
		if gui.pick_node(self.resume_btn, action.x, action.y) then
			set_paused(self, false)
			return true
		end
		return true
	end

	-- 5. Open Skill Tree button from HUD
	if gui.pick_node(self.skills_hud_btn, action.x, action.y) then
		show_skill_tree(self)
		return true
	end

	-- 6. Pause button
	if gui.pick_node(self.pause_btn, action.x, action.y) then
		set_paused(self, true)
		return true
	end

	return false
end
